<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/plantdex_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <include layout="@layout/header_role" android:id="@+id/header" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Edit Account Details"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_avatar_circle">
                            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_person" android:contentDescription="User" />
                        </FrameLayout>
                        <TextView android:id="@+id/tvEditAccName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                            android:text="John Doe" android:textColor="@color/plantdex_text_primary" android:textSize="17sp" android:textStyle="bold" />
                    </LinearLayout>

                    <include layout="@layout/row_label_value" android:id="@+id/rowUserId" />
                    <include layout="@layout/row_label_value" android:id="@+id/rowUsername" />
                    <include layout="@layout/row_label_value" android:id="@+id/rowCreationDate" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Full name" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etFullName" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Email" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box" android:paddingStart="14dp" android:paddingEnd="14dp" android:inputType="textEmailAddress" android:textColor="@color/plantdex_text_primary" android:textSize="14sp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Profile type" android:textColor="@color/plantdex_label" android:textStyle="bold" android:textSize="13sp" />
                    <Spinner
                        android:id="@+id/spinnerProfileType"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_box"
                        android:paddingStart="12dp"
                        android:spinnerMode="dropdown" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Account Status (tap to toggle):" android:textColor="@color/plantdex_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvAccountStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:text="ACTIVE" android:textColor="@color/plantdex_chip_text" android:textSize="11sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetPassword"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill"
                        android:text="Reset Password"
                        android:textAllCaps="false"
                        android:textColor="@color/plantdex_success_text"
                        android:textStyle="bold"
                        android:stateListAnimator="@null" />

                    <LinearLayout android:id="@+id/layoutEditAccError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:background="@drawable/bg_error_banner" android:padding="12dp" android:visibility="gone">
                        <TextView android:id="@+id/tvEditAccError" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚠ Error" android:textColor="@color/plantdex_error_text" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnUpdateAccount"
                            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                            android:background="@drawable/btn_primary" android:backgroundTint="@color/plantdex_chip_bg"
                            android:text="UPDATE" android:textColor="@color/plantdex_chip_text" android:textStyle="bold" android:stateListAnimator="@null" />
                        <Button
                            android:id="@+id/btnCancelAccount"
                            android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="10dp"
                            android:background="@drawable/btn_secondary"
                            android:text="CANCEL" android:textColor="@color/plantdex_secondary_text" android:textStyle="bold" android:stateListAnimator="@null" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/navContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
